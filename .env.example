VELIN_IMAGE=ghcr.io/ttyob/velin-web-ssh:latest
VELIN_ADDR=0.0.0.0:8377
# 以下两项仅用于源码运行；发布版容器已内置对应路径。
VELIN_DATA_DIR=data
VELIN_WEB_DIST=web/dist
VELIN_ADMIN_USER=admin
VELIN_ADMIN_PASSWORD=replace-with-a-strong-password
VELIN_COOKIE_SECURE=false
VELIN_HOST_PORT_ADDR=127.0.0.1
VELIN_GUACD_ADDR=127.0.0.1:4822
VELIN_DESKTOP_PROXY_ADDR=127.0.0.1
VELIN_RDP_DRIVE_DIR=/tmp/velin-rdp-drives
VELIN_RDP_RESIZE_METHOD=display-update
VELIN_RDP_DISABLE_GFX=false
VELIN_AI_BASE_URL=
VELIN_AI_MODEL=
VELIN_AI_API_KEY=
VELIN_FFMPEG_BINARY=ffmpeg
