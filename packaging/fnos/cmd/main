#!/bin/sh
set -eu

. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/common"

VELIN_PID="$RUN_ROOT/velin.pid"
GUACD_PID="$RUN_ROOT/guacd.pid"

stop_pid() {
  pid_file="$1"
  if [ ! -f "$pid_file" ]; then
    return 0
  fi
  pid=$(cat "$pid_file" 2>/dev/null || true)
  if pid_alive "$pid"; then
    kill "$pid" 2>/dev/null || true
    tries=0
    while pid_alive "$pid" && [ "$tries" -lt 20 ]; do
      sleep 0.25
      tries=$((tries + 1))
    done
    if pid_alive "$pid"; then
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$pid_file"
}

start() {
  mkdir -p "$RUN_ROOT" "$LOG_ROOT" "$RDP_DRIVE_ROOT" "$DATA_ROOT/data" \
    "$GUACD_HOME/.config" "$GUACD_HOME/.cache"
  load_config

  if [ -f "$GUACD_PID" ] && pid_alive "$(cat "$GUACD_PID")"; then
    :
  else
    rm -f "$GUACD_PID"
    HOME="$GUACD_HOME" \
      XDG_CONFIG_HOME="$GUACD_HOME/.config" \
      XDG_CACHE_HOME="$GUACD_HOME/.cache" \
      LC_ALL=C.UTF-8 \
      "$APP_ROOT/bin/guacd" > "$LOG_ROOT/guacd.log" 2>&1 &
    echo "$!" > "$GUACD_PID"
    sleep 1
    if ! pid_alive "$(cat "$GUACD_PID")"; then
      echo "guacd failed to start; see $LOG_ROOT/guacd.log" >&2
      # App Center removes TRIM_PKGVAR when installation rolls back. Forward
      # the child log so the failure remains available in /var/log/apps.
      if [ -f "$LOG_ROOT/guacd.log" ]; then
        cat "$LOG_ROOT/guacd.log" >&2
      fi
      return 1
    fi
  fi

  if [ -f "$VELIN_PID" ] && pid_alive "$(cat "$VELIN_PID")"; then
    return 0
  fi
  rm -f "$VELIN_PID"
  (
    cd "$DATA_ROOT/data"
    exec env \
      VELIN_ADDR="${VELIN_ADDR:-0.0.0.0:8377}" \
      VELIN_DATA_DIR="$DATA_ROOT/data" \
      VELIN_WEB_DIST="$APP_ROOT/web/dist" \
      VELIN_HOST_PORT_ADDR="${VELIN_HOST_PORT_ADDR:-127.0.0.1}" \
      VELIN_GUACD_ADDR="${VELIN_GUACD_ADDR:-127.0.0.1:4822}" \
      VELIN_DESKTOP_PROXY_ADDR="${VELIN_DESKTOP_PROXY_ADDR:-127.0.0.1}" \
      VELIN_RDP_DRIVE_DIR="$RDP_DRIVE_ROOT" \
      VELIN_RDP_RESIZE_METHOD="${VELIN_RDP_RESIZE_METHOD:-none}" \
      VELIN_RDP_DISABLE_GFX="${VELIN_RDP_DISABLE_GFX:-true}" \
      VELIN_FFMPEG_BINARY="${VELIN_FFMPEG_BINARY:-ffmpeg}" \
      "$APP_ROOT/bin/velin"
  ) > "$LOG_ROOT/velin.log" 2>&1 &
  echo "$!" > "$VELIN_PID"
  sleep 1
  if ! pid_alive "$(cat "$VELIN_PID")"; then
    echo "VelinWebSSH failed to start; see $LOG_ROOT/velin.log" >&2
    stop_pid "$GUACD_PID"
    return 1
  fi
}

reset_admin_password() {
  was_running=false
  if [ -f "$VELIN_PID" ] && pid_alive "$(cat "$VELIN_PID")"; then
    was_running=true
    stop_pid "$VELIN_PID"
  fi
  mkdir -p "$DATA_ROOT/data"
  load_config

  set +e
  (
    cd "$DATA_ROOT/data"
    env \
      VELIN_DATA_DIR="$DATA_ROOT/data" \
      VELIN_ADMIN_USER="${VELIN_ADMIN_USER:-admin}" \
      VELIN_ADMIN_PASSWORD="${VELIN_RESET_PASSWORD:-}" \
      "$APP_ROOT/bin/velin" --reset-admin-password
  )
  reset_status=$?
  set -e

  restart_status=0
  if [ "$was_running" = true ]; then
    start || restart_status=$?
  fi
  if [ "$reset_status" -ne 0 ]; then
    return "$reset_status"
  fi
  return "$restart_status"
}

case "${1:-}" in
  start|restart)
    if [ "${1:-}" = "restart" ]; then
      stop_pid "$VELIN_PID"
      stop_pid "$GUACD_PID"
    fi
    start
    ;;
  stop)
    stop_pid "$VELIN_PID"
    stop_pid "$GUACD_PID"
    ;;
  status)
    [ -f "$VELIN_PID" ] && pid_alive "$(cat "$VELIN_PID")" && \
      [ -f "$GUACD_PID" ] && pid_alive "$(cat "$GUACD_PID")"
    ;;
  reset-admin-password)
    reset_admin_password
    ;;
  *)
    printf 'Unknown command: %s\n' "${1:-}" >&2
    exit 1
    ;;
esac
